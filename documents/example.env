# Application Configuration
NEXT_PUBLIC_APP_NAME="FixBro Interiors"
NEXT_PUBLIC_WEBSITE_URL="https://yourdomain.com"
NEXT_PUBLIC_BASE_URL="https://yourdomain.com"
PORT=3004

# MySQL Database Configuration
MYSQL_HOST="127.0.0.1"
MYSQL_PORT=3306
MYSQL_DATABASE="fixbro_interiors"
MYSQL_USER="fixbro_user"
MYSQL_PASSWORD="CHANGE_THIS_STRONG_DB_PASSWORD"
MYSQL_CONNECTION_LIMIT=15

# Authentication & Initial Admin Setup
# Leave these blank or omit them to let `npm run init-db` auto-generate secure values on first run.
# If already set, `npm run init-db` will preserve and use your existing values.
AUTH_SECRET=
ADMIN_USERNAME=
DEFAULT_ADMIN_PASSWORD=
